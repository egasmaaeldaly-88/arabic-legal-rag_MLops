
# None of these are needed for the Quickstart (GENERATOR_BACKEND=extractive).

# --- Generator ---
GENERATOR_BACKEND=        # extractive (no key) | openai (any OpenAI-compatible server)
LLM_BASE_URL=             # e.g. Groq or vLLM endpoint
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_TOKENS=
LLM_EXTRA_BODY=
GROQ_API_KEY=             # used by docker-compose.groq.yml
GROQ_MODEL=

# --- RAGAS judge (evaluation only) ---
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_MAX_TOKENS=
JUDGE_MAX_WORKERS=
JUDGE_EXTRA_BODY=

# --- Langfuse (optional, tracing is off without these) ---
LANGFUSE_ENABLED=
LANGFUSE_HOST=
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- MLflow / alerts ---
MLFLOW_TRACKING_URI=
ALERT_WEBHOOK_URL=

# --- DVC remote (not an env var) ---
# Credentials go in .dvc/config.local, see README "Data pipeline".
# CI uses the GitHub secret DAGSHUB_TOKEN.